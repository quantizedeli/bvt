+#SBATCH --nodes=1
+#SBATCH --ntasks=1
+#SBATCH --cpus-per-task=112            # TRUBA 2025-12-15: 56/112 katları zorunlu
+#SBATCH --time=08:00:00                # 8 saat (3 seed × 2-2.5 saat + buffer)
+#SBATCH --output=/arf/scratch/ahmacar/logs/pfaz13_multiseed_%j.out
+#SBATCH --error=/arf/scratch/ahmacar/logs/pfaz13_multiseed_%j.err
