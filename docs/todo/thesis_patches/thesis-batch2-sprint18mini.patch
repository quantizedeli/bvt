+
+# Modülü yükle
+module purge
+module load apps/truba-ai/cpu-2024.0
+
+# Çalışma dizini
+WORK_DIR=/arf/home/ahmacar/hpcv1
+cd $WORK_DIR
+
+# Output dizini (scratch, 1TB)
+OUTPUT_BASE=/arf/scratch/ahmacar/hpcv1_outputs_multiseed
