+## 2. Kod değişiklikleri (Claude Code yapacak)
+
+### 2.1 Yeni dosya: `pfaz_modules/pfaz13_automl/multiseed_runner.py`
+
+```python
+"""
+PFAZ13 Multi-Seed AutoML Runner
+================================
+
+3 farklı seed ile AutoML çalıştırıp sonuçları toplar.
+Bouthillier & Varoquaux (2021, MLSys) varyans analizine uygun.
+
+Çıktı yapısı:
+    output_dir/
+    ├── seed_42/
+    │   ├── automl_summary.json
+    │   ├── automl_retraining_log.json
+    │   ├── automl_improvement_report.xlsx
+    │   └── automl_trials_details.xlsx
+    ├── seed_123/...
+    ├── seed_456/...
+    ├── multiseed_summary.json  (3 seed'in ortalama + std)
+    └── multiseed_report.xlsx   (karşılaştırma + güven aralığı)
+"""
+
+import json
+from pathlib import Path
+from typing import List, Dict, Any
+import numpy as np
+import pandas as pd
+from datetime import datetime
+
+# Mevcut AutoML modüllerini import et
+from pfaz_modules.pfaz13_automl.automl_optimizer import AutoMLOptimizer
+from pfaz_modules.pfaz13_automl.automl_retraining_loop import AutoMLRetrainingLoop
+
+
+class MultiSeedAutoMLRunner:
+    """3 seed ile AutoML çalıştırıp varyans analizi yapar."""
+    
+    def __init__(self, base_output_dir: Path, seeds: List[int] = None):
+        """
+        Args:
+            base_output_dir: Multi-seed output kökü (örn. hpcv1_outputs_multiseed/)
+            seeds: Liste seed'ler. Varsayılan [42, 123, 456].
+        """
+        self.base_output_dir = Path(base_output_dir)
+        self.base_output_dir.mkdir(parents=True, exist_ok=True)
+        self.seeds = seeds if seeds else [42, 123, 456]
+        self.seed_results: Dict[int, Dict[str, Any]] = {}
+    
+    def run_single_seed(self, seed: int, dataset_dir: Path, models_dir: Path) -> Dict[str, Any]:
+        """
+        Tek bir seed için AutoML çalıştırır.
+        
+        ÖNEMLİ: Mevcut AutoMLOptimizer'a seed parametresini geçer.
+        Hem TPESampler, hem RF/XGB/LGB random_state, hem np.random.seed
+        bu seed'e set edilir.
+        """
+        output_dir = self.base_output_dir / f"seed_{seed}"
+        output_dir.mkdir(parents=True, exist_ok=True)
+        
+        print(f"\n{'='*60}")
+        print(f"  Seed {seed} ile AutoML başlıyor")
+        print(f"  Output: {output_dir}")
+        print(f"  Başlangıç: {datetime.now().isoformat()}")
+        print(f"{'='*60}\n")
+        
+        # AutoMLOptimizer seed parametresiyle çağrılır
+        # Mevcut kod seed=42 hard-coded; bunu parametre yapmamız gerekiyor
+        # (2.2'de patch ediliyor)
+        optimizer = AutoMLOptimizer(
+            dataset_dir=dataset_dir,
+            output_dir=output_dir,
+            n_trials=30,
+            seed=seed,  # YENİ: explicit seed
+        )
+        
+        results = optimizer.run_all()
+        
+        # Retraining loop da seed ile çalıştır
+        retrainer = AutoMLRetrainingLoop(
+            automl_summary_path=output_dir / 'automl_summary.json',
+            models_dir=models_dir,
+            output_dir=output_dir,
+            seed=seed,  # YENİ
+        )
+        retrainer.run()
+        
+        # Sonuçları kaydet
+        seed_summary = {
+            'seed': seed,
+            'completed_at': datetime.now().isoformat(),
+            'results': results,
+            'output_dir': str(output_dir),
+        }
+        return seed_summary
+    
+    def run_all_seeds(self, dataset_dir: Path, models_dir: Path) -> None:
+        """3 seed sequential çalıştırır."""
+        for seed in self.seeds:
+            try:
+                self.seed_results[seed] = self.run_single_seed(seed, dataset_dir, models_dir)
+            except Exception as e:
+                print(f"\n[ERROR] Seed {seed} başarısız: {e}")
+                self.seed_results[seed] = {'seed': seed, 'error': str(e)}
+                # Devam et, diğer seed'lere geç
+        
+        # Tüm seed'ler bittikten sonra varyans analizi yap
+        self.aggregate_results()
+    
+    def aggregate_results(self) -> None:
+        """3 seed sonuçlarını birleştirir, ortalama + std hesaplar."""
+        agg_data = []
+        
+        for seed in self.seeds:
+            if seed not in self.seed_results or 'error' in self.seed_results[seed]:
+                continue
+            
+            seed_dir = self.base_output_dir / f"seed_{seed}"
+            summary_path = seed_dir / 'automl_summary.json'
+            
+            if not summary_path.exists():
+                continue
+            
+            with open(summary_path) as f:
+                summary = json.load(f)
+            
+            # MM ve QM için her model
+            for target in ['MM', 'QM']:
+                for model_type in ['rf', 'xgb', 'lgb']:
+                    if target in summary and model_type in summary[target]:
+                        row = {
+                            'seed': seed,
+                            'target': target,
+                            'model': model_type,
+                            'best_r2': summary[target][model_type].get('best_r2', np.nan),
+                            'n_trials': summary[target][model_type].get('n_trials', 0),
+                        }
+                        agg_data.append(row)
+        
+        if not agg_data:
+            print("[WARN] Hiçbir seed sonucu birleştirilemedi.")
+            return
+        
+        df = pd.DataFrame(agg_data)
+        
+        # Per target × model: ortalama + std
+        stats = df.groupby(['target', 'model'])['best_r2'].agg(
+            ['mean', 'std', 'min', 'max', 'count']
+        ).reset_index()
+        stats.columns = ['target', 'model', 'mean_r2', 'std_r2', 'min_r2', 'max_r2', 'n_seeds']
+        
+        # %95 güven aralığı (n=3 için t-distribution)
+        from scipy import stats as sp_stats
+        stats['ci95_lower'] = stats.apply(
+            lambda r: r['mean_r2'] - sp_stats.t.ppf(0.975, r['n_seeds']-1) 
+                      * r['std_r2'] / np.sqrt(r['n_seeds']) if r['n_seeds'] > 1 else np.nan,
+            axis=1
+        )
+        stats['ci95_upper'] = stats.apply(
+            lambda r: r['mean_r2'] + sp_stats.t.ppf(0.975, r['n_seeds']-1) 
+                      * r['std_r2'] / np.sqrt(r['n_seeds']) if r['n_seeds'] > 1 else np.nan,
+            axis=1
+        )
+        
+        # JSON çıktı
+        summary_path = self.base_output_dir / 'multiseed_summary.json'
+        with open(summary_path, 'w') as f:
+            json.dump({
+                'seeds': self.seeds,
+                'completed_at': datetime.now().isoformat(),
+                'stats': stats.to_dict('records'),
+                'raw_data': df.to_dict('records'),
+            }, f, indent=2)
+        
+        # Excel çıktı (tezde kullanılacak tablo)
+        excel_path = self.base_output_dir / 'multiseed_report.xlsx'
+        with pd.ExcelWriter(excel_path, engine='openpyxl') as writer:
+            df.to_excel(writer, sheet_name='Raw_Per_Seed', index=False)
+            stats.to_excel(writer, sheet_name='Aggregated_Stats', index=False)
+            
+            # Snapshot karşılaştırması (mevcut tek-seed vs yeni 3-seed)
+            comparison = self._make_snapshot_comparison(stats)
+            comparison.to_excel(writer, sheet_name='Snapshot_vs_Multiseed', index=False)
+        
+        print(f"\n{'='*60}")
+        print(f"  Multi-seed analizi tamamlandı")
+        print(f"  Özet: {summary_path}")
+        print(f"  Excel: {excel_path}")
+        print(f"{'='*60}\n")
+        print(stats.to_string(index=False))
+    
+    def _make_snapshot_comparison(self, stats: pd.DataFrame) -> pd.DataFrame:
+        """Mevcut snapshot tek-seed vs yeni multiseed karşılaştırması."""
+        # Snapshot'tan tek-seed (42) sonucu oku
+        snapshot_summary = Path('thesis/_data_snapshot/2026-05-21/automl_summary.json')
+        if not snapshot_summary.exists():
+            return pd.DataFrame()
+        
+        with open(snapshot_summary) as f:
+            snap = json.load(f)
+        
+        rows = []
+        for target in ['MM', 'QM']:
+            for model_type in ['rf', 'xgb', 'lgb']:
+                if target in snap and model_type in snap[target]:
+                    snap_r2 = snap[target][model_type].get('best_r2', np.nan)
+                    
+                    multi = stats[(stats['target']==target) & (stats['model']==model_type)]
+                    if len(multi) > 0:
+                        row = {
+                            'target': target,
+                            'model': model_type,
+                            'snapshot_r2_seed42': snap_r2,
+                            'multiseed_mean': multi['mean_r2'].iloc[0],
+                            'multiseed_std': multi['std_r2'].iloc[0],
+                            'multiseed_ci95': f"[{multi['ci95_lower'].iloc[0]:.4f}, {multi['ci95_upper'].iloc[0]:.4f}]",
+                            'fark': multi['mean_r2'].iloc[0] - snap_r2,
+                        }
+                        rows.append(row)
+        
+        return pd.DataFrame(rows)
+
+
+if __name__ == '__main__':
+    import sys
+    base = Path(sys.argv[1]) if len(sys.argv) > 1 else Path('hpcv1_outputs_multiseed')
+    
+    # Veri yolları (mevcut snapshot'tan)
+    dataset_dir = Path('hpcv1_outputs/generated_datasets')
+    models_dir = Path('hpcv1_outputs/trained_models')
+    
+    runner = MultiSeedAutoMLRunner(base_output_dir=base, seeds=[42, 123, 456])
+    runner.run_all_seeds(dataset_dir=dataset_dir, models_dir=models_dir)
+```
+
+### 2.2 Mevcut kod güncellemesi: `automl_optimizer.py` — seed parametresi açık edilmeli
+
+**Sorun:** Şu anki kodda `random_state=42` ve `TPESampler(seed=42)` **hard-coded**. Multiseed için bunu parametre yapmalıyız.
+
+**Etkilenen dosyalar:**
+
+#### `pfaz_modules/pfaz13_automl/automl_hyperparameter_optimizer.py`
+
+Şu kalıbı bul:
+```python
+class AutoMLHyperparameterOptimizer:
+    def __init__(self, ...):
+        ...
+        # Eski:
+        # self.sampler = TPESampler(seed=42)
+```
+
+Şuna değiştir:
+```python
+class AutoMLHyperparameterOptimizer:
+    def __init__(self, ..., seed: int = 42):
+        ...
+        self.seed = seed
+        self.sampler = TPESampler(seed=self.seed)
+```
+
+Sonra `objective()` ve diğer methodlarda `random_state=42` → `random_state=self.seed`.
+
+#### `pfaz_modules/pfaz13_automl/automl_optimizer.py`
+
+Bütün `random_state=42` ve hard-coded seed'leri `self.seed`'e bağla. Init'e `seed: int = 42` parametresi ekle. Aynı şekilde `automl_retraining_loop.py` ve `automl_anfis_optimizer.py`.
+
+Detay grep ile:
+```bash
+grep -rn "random_state=42\|seed=42\|np.random.seed(42)" pfaz_modules/pfaz13_automl/
+```
+
+Tüm `42`'leri `self.seed`'e çevir.
+
