+## Hızlı script — tüm kontrolleri çalıştır
+
+```bash
+#!/bin/bash
+# submission-check.sh
+cd thesis/
+
+echo "=== TIER 1: İçerik tamlığı ==="
+for f in 00-ozet 01-giris 02-literatur 03-yontem 04-uygulama 05-bulgular 06-tartisma 07-sonuc 08-kaynakca 09-ekler; do
+    if [ -f "${f}-*.md" ] || [ -f "${f}.md" ]; then
+        size=$(wc -c < ${f}*.md)
+        echo "✅ $f ($size byte)"
+    else
+        echo "❌ $f EKSIK"
+    fi
+done
+
+echo ""
+echo "=== TIER 2: Sayısal tutarlılık ==="
+for num in 267 75 34 1472 942 20 8 "0,8886" "-3,18" "0,0015"; do
+    count=$(grep -r "$num" *.md 2>/dev/null | wc -l)
+    if [ $count -lt 2 ]; then
+        echo "⚠️  $num: sadece $count yerde geçiyor"
+    else
+        echo "✅ $num: $count yerde"
+    fi
+done
+
+echo ""
+echo "=== TIER 3: Placeholder ==="
+hits=$(grep -rcn "TODO\|FIXME\|XXX\|\[TBD\]" *.md | grep -v ":0$")
+if [ -z "$hits" ]; then
+    echo "✅ Placeholder yok"
+else
+    echo "❌ Placeholder tespit:"
+    echo "$hits"
+fi
+
+echo ""
+echo "=== TIER 4: PDF ==="
+if [ -f output/tez.pdf ]; then
+    size=$(du -h output/tez.pdf | cut -f1)
+    pages=$(pdfinfo output/tez.pdf | grep Pages | awk '{print $2}')
+    echo "✅ tez.pdf — $size, $pages sayfa"
+else
+    echo "❌ output/tez.pdf YOK"
+fi
+
+echo ""
+echo "Toplam: $(grep -c ✅ <<< "$(...)") başarılı, $(grep -c ❌ <<< "$(...)") başarısız"
+```
